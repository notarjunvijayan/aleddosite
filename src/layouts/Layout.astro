---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Aleddo Technologies | Orchestrating Unified Intelligence",
	description = "Aleddo Technologies delivers bespoke AI applications, workflow automation, custom software, and enterprise data engineering across Dubai and India.",
} = Astro.props;
---

<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link
			rel="preload"
			href="/fonts/clash-grotesk/ClashGrotesk-Variable.woff2"
			as="font"
			type="font/woff2"
			crossorigin="anonymous"
		/>
		<link
			rel="preload"
			href="/fonts/clash-grotesk/ClashGrotesk-Bold.woff2"
			as="font"
			type="font/woff2"
			crossorigin="anonymous"
		/>
		<link
			rel="preload"
			href="/fonts/clash-grotesk/ClashGrotesk-Semibold.woff2"
			as="font"
			type="font/woff2"
			crossorigin="anonymous"
		/>
		<link
			rel="preload"
			href="/fonts/clash-grotesk/ClashGrotesk-Regular.woff2"
			as="font"
			type="font/woff2"
			crossorigin="anonymous"
		/>
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={Astro.url.href} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#03045A" />

		<!-- OpenGraph / Social Metadata -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url.href} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content="Aleddo Technologies" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<!-- JSON-LD Structured Data for Enterprise AI & Services -->
		<script type="application/ld+json" is:inline>
			{
				"@context": "https://schema.org",
				"@type": "ProfessionalService",
				"name": "Aleddo Technologies",
				"url": "https://aleddotechnologies.com",
				"logo": "https://aleddotechnologies.com/favicon.svg",
				"description": "Bespoke AI applications, workflow automation, custom software, and enterprise data engineering for clients in regulated industries.",
				"address": [
					{
						"@type": "PostalAddress",
						"streetAddress": "6th Floor, Meydan Grandstand, Meydan Road, Nad Al Sheba",
						"addressLocality": "Dubai",
						"addressCountry": "AE"
					},
					{
						"@type": "PostalAddress",
						"addressLocality": "Ernakulam",
						"addressRegion": "Kerala",
						"addressCountry": "IN"
					}
				],
				"telephone": "+971502978387",
				"email": "contact@aleddotechnologies.com"
			}
		</script>
	</head>
	<body class="bg-brand-bg text-brand-text font-sans antialiased min-h-screen flex flex-col selection:bg-brand-tertiary selection:text-brand-bg">
		<!-- Skip to Main Content Link for Accessibility -->
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-brand-tertiary focus:text-brand-bg focus:font-bold focus:shadow-xl outline-none"
		>
			Skip to main content
		</a>
		<slot />
		<script>
			const updateNavHeight = () => {
				const nav = document.getElementById("navbar-container");
				if (nav) {
					document.documentElement.style.setProperty("--nav-h", `${nav.offsetHeight}px`);
				}
			};
			updateNavHeight();
			window.addEventListener("resize", updateNavHeight);
			document.addEventListener("DOMContentLoaded", updateNavHeight);
		</script>
	</body>
</html>

