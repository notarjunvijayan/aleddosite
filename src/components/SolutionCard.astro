---
import SolutionButton from "./SolutionButton.astro";

interface Props {
  title: string;
  description: string;
  capabilities: string[];
  buttonText?: string;
  buttonHref?: string;
  bgImage?: string;
}

const {
  title,
  description,
  capabilities,
  buttonText = "Evolve",
  buttonHref = "#",
  bgImage = "/images/ai_robot_solution_bg.png",
} = Astro.props;
---

<div
  class="solution-card relative w-full border-b border-brand-text/25 p-8 md:p-12 lg:p-16 overflow-hidden bg-brand-bg flex flex-col justify-between min-h-[500px]"
>
  <!-- Background Image with Gradient Masking -->
  {
    bgImage && (
      <div class="absolute inset-0 pointer-events-none z-0 overflow-hidden flex justify-end">
        <img
          src={bgImage}
          alt={title}
          class="w-full md:w-3/4 lg:w-2/3 h-full object-cover object-center opacity-40 md:opacity-60 mix-blend-luminosity hover:mix-blend-normal transition-all duration-700"
        />
        <!-- Left Gradient Mask so text is always 100% legible -->
        <div class="absolute inset-0 bg-gradient-to-r from-brand-bg via-brand-bg/90 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-brand-bg via-transparent to-brand-bg/30"></div>
      </div>
    )
  }

  <!-- Content Container -->
  <div class="relative z-10 max-w-2xl lg:max-w-3xl flex flex-col justify-between h-full space-y-8 md:space-y-10">
    <div class="space-y-6 md:space-y-8">
      <!-- Title -->
      <h3 class="text-4xl md:text-5xl lg:text-6xl xl:text-6xl font-semibold tracking-tight text-brand-text leading-tight">
        {title}
      </h3>

      <!-- Description -->
      <p class="text-lg md:text-xl lg:text-2xl text-brand-text/90 font-normal leading-relaxed">
        {description}
      </p>

      <!-- Core Capabilities -->
      {
        capabilities && capabilities.length > 0 && (
          <div class="pt-2 md:pt-4 space-y-4">
            <h4 class="text-xl md:text-2xl lg:text-3xl font-semibold text-brand-text tracking-wide">
              Core Capabilities
            </h4>
            <ul class="space-y-3 text-base md:text-lg lg:text-xl text-brand-text/85 font-normal">
              {capabilities.map((cap) => (
                <li class="flex items-start space-x-3">
                  <span class="inline-block w-2 h-2 rounded-full bg-brand-tertiary mt-2.5 shrink-0"></span>
                  <span>{cap}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>

    <!-- Solution Action Button -->
    <div class="pt-6">
      <SolutionButton text={buttonText} href={buttonHref} />
    </div>
  </div>
</div>
