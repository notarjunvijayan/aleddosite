<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const initSealAnimation = () => {
        const section = document.getElementById("dubai-ai-seal-section");
        if (!section) return;

        const lines = section.querySelectorAll(".seal-line");
        const skylines = section.querySelectorAll(".seal-skyline");
        const logo = section.querySelector(".seal-logo");
        const heading = section.querySelector(".seal-heading");
        const text = section.querySelector(".seal-text");

        // Set initial state
        if (lines.length) {
            gsap.set(lines, { scaleY: 0, transformOrigin: "top center" });
        }
        if (skylines.length) {
            gsap.set(skylines, { y: 35, opacity: 0 });
        }
        if (logo) {
            gsap.set(logo, { y: 25, opacity: 0 });
        }
        if (heading) {
            gsap.set(heading, { y: 25, opacity: 0 });
        }
        if (text) {
            gsap.set(text, { y: 20, opacity: 0 });
        }

        const tl = gsap.timeline({
            scrollTrigger: {
                trigger: section,
                start: "top 85%",
                toggleActions: "play none none none",
            },
            defaults: { ease: "power4.out" },
        });

        // 1. Draw vertical grid lines
        if (lines.length) {
            tl.to(lines, {
                scaleY: 1,
                duration: 0.65,
                stagger: 0.08,
            });
        }

        // 2. Pan skyline SVGs up from bottom
        if (skylines.length) {
            tl.to(
                skylines,
                {
                    y: 0,
                    opacity: 1,
                    duration: 0.6,
                    stagger: 0.06,
                },
                lines.length ? "-=0.5" : "0",
            );
        }

        // 3. Reveal DCAI Logo & text content up from bottom
        if (logo) {
            tl.to(
                logo,
                {
                    y: 0,
                    opacity: 1,
                    duration: 0.45,
                },
                "-=0.45",
            );
        }

        if (heading) {
            tl.to(
                heading,
                {
                    y: 0,
                    opacity: 1,
                    duration: 0.45,
                },
                "-=0.45",
            );
        }

        if (text) {
            tl.to(
                text,
                {
                    y: 0,
                    opacity: 1,
                    duration: 0.4,
                },
                "-=0.35",
            );
        }
    };

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initSealAnimation);
    } else {
        initSealAnimation();
    }
</script>
