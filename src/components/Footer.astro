<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initFooterAnimations = () => {
    const footer = document.getElementById("footer-container");
    if (!footer) return;

    const linesH = footer.querySelectorAll(".footer-line-h");
    const cols = footer.querySelectorAll(".footer-col");
    const bottomTexts = footer.querySelectorAll(".footer-bottom-text");

    if (linesH.length) gsap.set(linesH, { scaleX: 0, transformOrigin: "left center" });
    if (cols.length) gsap.set(cols, { y: 25, opacity: 0 });
    if (bottomTexts.length) gsap.set(bottomTexts, { y: 15, opacity: 0 });

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: footer,
        start: "top 85%",
        toggleActions: "play none none none",
      },
      defaults: { ease: "power4.out" },
    });

    if (linesH.length) {
      tl.to(linesH, { scaleX: 1, duration: 0.45, stagger: 0.08 });
    }

    if (cols.length) {
      tl.to(cols, { y: 0, opacity: 1, duration: 0.35, stagger: 0.06 }, "-=0.35");
    }

    if (bottomTexts.length) {
      tl.to(bottomTexts, { y: 0, opacity: 1, duration: 0.3, stagger: 0.05 }, "-=0.2");
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initFooterAnimations);
  } else {
    initFooterAnimations();
  }
</script>
