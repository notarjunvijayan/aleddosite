---
import SolutionCard from "./SolutionCard.astro";

// 1. Custom AI Solutions Capabilities
const customAiCapabilities = [
  "Predictive Analytics & Machine Learning Model Development",
  "Computer Vision & Natural Language Processing (NLP)",
  "Generative AI & AI-Powered RPA",
  "Intelligent Document Processing & OCR Automation",
];

// 2. AI Automation, Chatbots & Voice Agents Sub-Blocks
const aiAutomationSubBlocks = [
  {
    title: "Document & Workflow Automation",
    description:
      "Automatically extract, validate, and route data from PDFs, scanned forms, invoices, and Excel spreadsheets using custom business rules.\n\nException handling flags edge cases for human review while routine tasks move forward automatically.",
    buttonText: "Evolve",
    buttonHref: "#",
  },
  {
    title: "Agentic AI, Chatbots & Voice Agents",
    features: [
      {
        label: "Customer Support Agents",
        text: 'Handle complex inquiries (e.g., "Where is my order?" or "How do I request a quote?") using NLP and RAG. Trained on your specific domain with seamless human-agent handoffs mid-conversation.',
      },
      {
        label: "Internal Assistants",
        text: "Allow employees to query operational data using plain language or execute internal requests (e.g., filing leave applications) directly through conversational interfaces.",
      },
    ],
    buttonText: "Evolve",
    buttonHref: "#",
  },
];

// 3. Custom Web & Software Development Features
const webSoftwareFeatures = [
  {
    label: "Tailored Applications",
    text: "From specialized internal tools to enterprise-grade platforms.",
  },
  {
    label: "Built to Scale",
    text: "Designed for peak performance, security, and effortless scaling as your user base grows.",
  },
];

// 4. Business Intelligence & Data Engineering Features
const biDataFeatures = [
  {
    label: "Real-time Visibility",
    text: "Dashboards and reports that accurately reflect your daily operational reality.",
  },
  {
    label: "Automated Reporting",
    text: "Eliminate weekly manual data collection and reporting.",
  },
  {
    label: "Scalable Data Architecture",
    text: "Infrastructure built to handle long-term growth without breaking under pressure.",
  },
];
---

<section
  id="about-aleddo-section"
  class="relative w-full bg-brand-bg text-brand-text border-b border-brand-text/25"
>
  <div class="w-full flex flex-col lg:flex-row items-stretch">
    <!-- Left Column: Sticky Heading aligned to top baseline of right section -->
    <div
      class="w-full lg:w-[28%] xl:w-[26%] border-b lg:border-b-0 lg:border-r border-brand-text/25 p-6 sm:p-8 md:p-12 lg:p-16 xl:p-20 py-8 sm:py-10 shrink-0 flex flex-col justify-start lg:min-h-screen"
    >
      <div class="lg:sticky lg:top-24 space-y-2">
        <h2
          class="about-heading text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold tracking-tight leading-tight text-brand-text flex flex-row space-x-3 lg:block"
        >
          <span class="block text-brand-text">About</span>
          <span class="block text-brand-tertiary">Aleddo</span>
        </h2>
      </div>
    </div>

    <!-- Right Column: Scrollable Content Area -->
    <div class="w-full lg:w-[72%] xl:w-[74%] flex flex-col min-w-0">
      <!-- About Paragraph Block -->
      <div
        class="about-paragraph-block w-full p-6 sm:p-8 md:p-12 lg:p-16 xl:p-20 py-8 sm:py-10 md:py-16 border-b border-brand-text/25 flex items-start justify-start min-h-0 lg:min-h-[460px]"
      >
        <p
          class="max-w-2xl lg:max-w-3xl text-base sm:text-lg md:text-xl lg:text-2xl text-brand-text/85 leading-relaxed"
        >
          At <strong class="text-brand-text font-semibold">Aleddo</strong>, we
          are your dedicated, one-stop IT solution partner. We believe
          technology should work for your business, not add complexity to it.
          Whether you are looking to harness the power of modern AI, untangle
          complex data, or build software tailored to your specific operations,
          our goal is simple: deliver high-performance, scalable solutions that
          drive real results, automate repetitive tasks, and empower your team
          to focus on what matters most.
        </p>
      </div>

      <!-- Solution 1: Custom AI Solutions -->
      <SolutionCard
        title="Custom AI Solutions"
        description="We build tailored artificial intelligence applications that automate, optimize, and scale your operations from the ground up."
        capabilities={customAiCapabilities}
        buttonText="Evolve"
        buttonHref="#"
        bgImage="/images/ai_robot_solution_bg.webp"
      />

      <!-- Solution 2: AI Automation, Chatbots & Voice Agents -->
      <SolutionCard
        title="AI Automation, Chatbots & Voice Agents"
        subBlocks={aiAutomationSubBlocks}
        bgImage="/images/ai_chatbot_voice_bg.webp"
      />

      <!-- Solution 3: Custom Web & Software Development -->
      <SolutionCard
        title="Custom Web & Software Development"
        description="Off-the-shelf software often forces you to compromise your processes. We engineer custom web and software solutions built specifically around how your business functions."
        features={webSoftwareFeatures}
        buttonText="Evolve"
        buttonHref="#"
        bgImage="/images/custom_web_software_bg.webp"
      />

      <!-- Solution 4: Business Intelligence, Advanced Analytics & Data Engineering -->
      <SolutionCard
        title="Business Intelligence, Advanced Analytics & Data Engineering"
        description="Most businesses are sitting on more data than they know what to do with. We transform raw data into actionable insights using industry-leading tools like Power BI, Tableau, and Alteryx."
        features={biDataFeatures}
        buttonText="Evolve"
        buttonHref="#"
        bgImage="/images/bi_data_engineering_bg.webp"
      />
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initAboutAnimation = () => {
    const section = document.getElementById("about-aleddo-section");
    if (!section) return;

    const heading = section.querySelector(".about-heading");
    const paragraphBlock = section.querySelector(".about-paragraph-block");
    const cards = section.querySelectorAll(".solution-card");

    if (heading) gsap.set(heading, { y: 30, opacity: 0 });
    if (paragraphBlock) gsap.set(paragraphBlock, { y: 30, opacity: 0 });
    if (cards.length) gsap.set(cards, { y: 40, opacity: 0 });

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: "top 80%",
        toggleActions: "play none none none",
      },
      defaults: { ease: "power4.out" },
    });

    if (heading) {
      tl.to(heading, { y: 0, opacity: 1, duration: 0.6 });
    }

    if (paragraphBlock) {
      tl.to(paragraphBlock, { y: 0, opacity: 1, duration: 0.6 }, "-=0.4");
    }

    if (cards.length) {
      cards.forEach((card) => {
        gsap.to(card, {
          y: 0,
          opacity: 1,
          duration: 0.65,
          ease: "power4.out",
          scrollTrigger: {
            trigger: card,
            start: "top 85%",
            toggleActions: "play none none none",
          },
        });
      });
    }
  };

  if (document.readyState === "complete") {
    initAboutAnimation();
  } else {
    window.addEventListener("load", initAboutAnimation);
  }
</script>
