---
import SolutionButton from "./SolutionButton.astro";

const capabilities = [
  {
    title: "Automate the Queue",
    description:
      "Conversational AI, RPA, and agentic workflows that clear repetitive operational work end to end.",
    tags: ["Conversational AI", "RPA", "Agentic AI"],
    href: "/services#automate",
  },
  {
    title: "Predict the Outcome",
    description:
      "Forecasting, risk scoring, and anomaly detection calibrated precisely to a decision threshold.",
    tags: ["Forecasting", "Risk Scoring", "Anomaly Detection"],
    href: "/services#predict",
  },
  {
    title: "Read the Paperwork",
    description:
      "Document intelligence with confidence scoring and an automated human review queue below threshold.",
    tags: ["Extraction", "Validation", "Review Queue"],
    href: "/services#understand-documents",
  },
  {
    title: "Govern the Estate",
    description:
      "Model inventories, evaluation records, and MLOps monitoring mapped to recognized frameworks.",
    tags: ["NIST AI RMF", "ISO 42001", "Monitoring"],
    href: "/services#govern-monitor",
  },
];
---

<section
  id="about-aleddo-section"
  class="relative w-full bg-brand-bg text-brand-text border-b border-brand-text/30 overflow-hidden"
>
  <div class="w-full flex flex-col lg:flex-row items-stretch relative">
    <!-- Left Column: Heading & Subtext (Moved from top right) -->
    <div
      class="w-full lg:w-[32%] xl:w-[30%] border-b lg:border-b-0 border-r-0 lg:border-r border-brand-text/30 p-6 sm:p-8 md:p-12 lg:p-14 shrink-0 flex flex-col justify-start relative bg-brand-bg"
    >
      <div class="lg:sticky lg:top-[calc(var(--nav-h,5rem)+1rem)] space-y-4">
        <h2
          class="about-heading text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-tight text-brand-text"
        >
          <span class="block text-brand-text">What We Build,</span>
          <span class="block text-brand-tertiary">in a Nutshell</span>
        </h2>
        <p
          class="text-base sm:text-lg lg:text-xl text-brand-text/85 font-normal leading-relaxed pt-1"
        >
          At <strong class="text-brand-text font-semibold">Aleddo</strong>, we
          ship custom AI models, agentic workflows, and automated decision
          systems engineered for clients in regulated industries.
        </p>

        <div class="pt-4">
          <SolutionButton text="Explore Services" href="/services" />
        </div>
      </div>
    </div>

    <!-- Right Column: 2x2 Capabilities Grid Starting Directly at Top -->
    <div class="w-full lg:w-[68%] xl:w-[70%] flex flex-col min-w-0">
      <div
        class="grid grid-cols-1 md:grid-cols-2 w-full relative divide-y md:divide-y-0 border-b border-brand-text/30"
      >
        {
          capabilities.map((cap, idx) => (
            <div
              class={`about-card p-6 sm:p-8 md:p-12 flex flex-col justify-between space-y-6 bg-brand-bg hover:bg-brand-surface/15 transition-colors border-b ${idx % 2 === 0 ? "md:border-r border-brand-text/30" : "border-brand-text/30"}`}
            >
              <div class="space-y-3">
                <h3 class="text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight text-brand-text">
                  {cap.title}
                </h3>
                <p class="text-base sm:text-lg text-brand-text/80 leading-relaxed">
                  {cap.description}
                </p>
              </div>

              <div class="space-y-4 pt-2">
                <div class="flex flex-wrap gap-2.5">
                  {cap.tags.map((tag) => (
                    <span class="px-3.5 py-1.5 text-xs sm:text-sm font-mono font-medium text-brand-tertiary bg-brand-surface/60 border border-brand-text/25">
                      {tag}
                    </span>
                  ))}
                </div>

                <div>
                  <a
                    href={cap.href}
                    class="inline-flex items-center text-brand-text/85 hover:text-brand-tertiary text-sm sm:text-base font-medium transition-colors duration-300 py-1.5 border-b border-transparent hover:border-brand-tertiary group"
                  >
                    <span>Explore Capability</span>
                    <span class="ml-2 group-hover:translate-x-1 transition-transform duration-300">&rarr;</span>
                  </a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initAboutAnimation = () => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const section = document.getElementById("about-aleddo-section");
    if (!section) return;

    const heading = section.querySelector(".about-heading");
    const cards = section.querySelectorAll(".about-card");

    if (heading) gsap.set(heading, { y: 20, opacity: 0 });
    if (cards.length) gsap.set(cards, { y: 20, opacity: 0 });

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: "top 80%",
        toggleActions: "play none none none",
      },
      defaults: { ease: "power4.out" },
    });

    if (heading) {
      tl.to(heading, { y: 0, opacity: 1, duration: 0.4 });
    }

    if (cards.length) {
      tl.to(
        cards,
        { y: 0, opacity: 1, duration: 0.35, stagger: 0.06 },
        "-=0.25",
      );
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAboutAnimation);
  } else {
    initAboutAnimation();
  }
</script>
