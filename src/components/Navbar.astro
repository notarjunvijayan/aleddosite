---

---

<header
  id="navbar-container"
  class="sticky top-0 z-40 border-b border-brand-text/25 bg-brand-bg/85 backdrop-blur-md"
>
  <nav class="flex px-6 md:px-10 py-5 w-full items-center justify-between">
    <!-- Brand Logo -->
    <a
      href="/"
      class="font-bold text-lg md:text-xl tracking-wide text-brand-text hover:text-brand-tertiary transition-colors"
    >
      Aleddo Technologies
    </a>

    <!-- Desktop Navigation Links -->
    <div class="hidden md:flex items-center space-x-8 text-lg font-medium">
      <a
        href="/"
        class="text-brand-text hover:text-brand-tertiary transition-colors py-1"
      >
        Home
      </a>
      <a
        href="/#about-aleddo-section"
        class="text-brand-text/80 hover:text-brand-tertiary transition-colors py-1"
      >
        Solutions
      </a>
      <a
        href="#"
        class="text-brand-text/80 hover:text-brand-tertiary transition-colors py-1"
      >
        AI Studio
      </a>
      <a
        href="/contact"
        class="text-brand-text/80 hover:text-brand-tertiary transition-colors py-1"
      >
        Contact
      </a>
    </div>

    <!-- Mobile Hamburger Button -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="md:hidden p-2 text-brand-text hover:text-brand-tertiary focus:outline-none transition-colors"
      aria-label="Open navigation menu"
      aria-expanded="false"
    >
      <svg
        class="w-7 h-7 stroke-current"
        fill="none"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </nav>
</header>

<!-- Full-Screen Mobile Navigation Overlay -->
<div
  id="mobile-nav-overlay"
  class="fixed inset-0 z-50 bg-brand-bg text-brand-text flex flex-col justify-between p-6 sm:p-10 pointer-events-none opacity-0 invisible"
  aria-hidden="true"
>
  <!-- Full-screen Header -->
  <div class="flex items-center justify-between w-full border-b border-brand-text/25 pb-5">
    <a
      href="/"
      class="mobile-nav-item font-bold text-xl tracking-wide text-brand-text"
    >
      Aleddo Technologies
    </a>

    <!-- Close Button (X) -->
    <button
      id="mobile-menu-close-btn"
      type="button"
      class="p-2 text-brand-text hover:text-brand-tertiary focus:outline-none transition-colors"
      aria-label="Close navigation menu"
    >
      <svg
        class="w-8 h-8 stroke-current"
        fill="none"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Full-screen Navigation Links -->
  <div class="my-auto flex flex-col space-y-6 sm:space-y-8 py-8">
    <a
      href="/"
      class="mobile-nav-link text-4xl sm:text-5xl font-semibold tracking-tight text-brand-text hover:text-brand-tertiary transition-colors w-fit"
    >
      Home
    </a>
    <a
      href="/#about-aleddo-section"
      class="mobile-nav-link text-4xl sm:text-5xl font-semibold tracking-tight text-brand-text/85 hover:text-brand-tertiary transition-colors w-fit"
    >
      Solutions
    </a>
    <a
      href="#"
      class="mobile-nav-link text-4xl sm:text-5xl font-semibold tracking-tight text-brand-text/85 hover:text-brand-tertiary transition-colors w-fit"
    >
      AI Studio
    </a>
    <a
      href="#"
      class="mobile-nav-link text-4xl sm:text-5xl font-semibold tracking-tight text-brand-text/85 hover:text-brand-tertiary transition-colors w-fit"
    >
      Case Studies
    </a>
    <a
      href="/contact"
      class="mobile-nav-link text-4xl sm:text-5xl font-semibold tracking-tight text-brand-text/85 hover:text-brand-tertiary transition-colors w-fit"
    >
      Contact
    </a>
  </div>
</div>

<script>
  import gsap from "gsap";

  const openBtn = document.getElementById("mobile-menu-btn");
  const closeBtn = document.getElementById("mobile-menu-close-btn");
  const overlay = document.getElementById("mobile-nav-overlay");
  const navLinks = document.querySelectorAll(".mobile-nav-link");

  let isOpen = false;
  let isAnimating = false;

  const openMobileMenu = () => {
    if (!overlay || isOpen || isAnimating) return;
    isAnimating = true;

    // Lock background scrolling
    document.body.style.overflow = "hidden";

    // Set initial states
    gsap.set(overlay, { opacity: 0, scale: 1.02, visibility: "visible", pointerEvents: "auto" });
    gsap.set(navLinks, { y: 35, opacity: 0 });

    const tl = gsap.timeline({
      onComplete: () => {
        isOpen = true;
        isAnimating = false;
        overlay.setAttribute("aria-hidden", "false");
        openBtn?.setAttribute("aria-expanded", "true");
      },
    });

    // Snappy entrance timeline
    tl.to(overlay, {
      opacity: 1,
      scale: 1,
      duration: 0.32,
      ease: "power4.out",
    }).to(
      navLinks,
      {
        y: 0,
        opacity: 1,
        duration: 0.35,
        stagger: 0.05,
        ease: "power4.out",
      },
      "-=0.2"
    );
  };

  const closeMobileMenu = () => {
    if (!overlay || !isOpen || isAnimating) return;
    isAnimating = true;

    const tl = gsap.timeline({
      onComplete: () => {
        gsap.set(overlay, { opacity: 0, visibility: "hidden", pointerEvents: "none" });
        document.body.style.overflow = "";
        isOpen = false;
        isAnimating = false;
        overlay.setAttribute("aria-hidden", "true");
        openBtn?.setAttribute("aria-expanded", "false");
      },
    });

    tl.to(navLinks, {
      y: 20,
      opacity: 0,
      duration: 0.2,
      stagger: 0.03,
      ease: "power3.in",
    }).to(
      overlay,
      {
        opacity: 0,
        scale: 0.98,
        duration: 0.22,
        ease: "power3.in",
      },
      "-=0.1"
    );
  };

  if (openBtn) openBtn.addEventListener("click", openMobileMenu);
  if (closeBtn) closeBtn.addEventListener("click", closeMobileMenu);

  // Close menu when clicking any nav link inside overlay
  navLinks.forEach((link) => {
    link.addEventListener("click", () => {
      closeMobileMenu();
    });
  });
</script>
