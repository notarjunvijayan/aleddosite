---
import Logo from "./Logo.astro";

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, "") || "/";
---

<header
  id="navbar-container"
  class="sticky top-0 z-40 border-b border-brand-text/25 bg-brand-bg/85 backdrop-blur-md"
>
  <nav class="flex px-6 md:px-10 py-2 sm:py-2.5 w-full items-center justify-between">
    <!-- Brand Logo -->
    <a
      href="/"
      class="group transition-transform duration-300 hover:scale-[1.02]"
    >
      <Logo class="h-14 sm:h-18 md:h-20" />
    </a>

    <!-- Desktop Navigation Links -->
    <div class="hidden md:flex items-center space-x-8 text-lg font-medium">
      <a
        href="/"
        class={`py-1 transition-colors tracking-wide leading-none ${currentPath === "/" ? "text-white font-semibold underline underline-offset-8 decoration-2 decoration-white" : "text-brand-text/75 hover:text-white"}`}
      >
        Home
      </a>
      <a
        href="/services"
        class={`py-1 transition-colors tracking-wide leading-none ${currentPath === "/services" ? "text-white font-semibold underline underline-offset-8 decoration-2 decoration-white" : "text-brand-text/75 hover:text-white"}`}
      >
        Services
      </a>
      <a
        href="/ai-studio"
        class={`py-1 transition-colors tracking-wide leading-none ${currentPath === "/ai-studio" ? "text-white font-semibold underline underline-offset-8 decoration-2 decoration-white" : "text-brand-text/75 hover:text-white"}`}
      >
        AI Studio
      </a>
      <a
        href="/about"
        class={`py-1 transition-colors tracking-wide leading-none ${currentPath === "/about" ? "text-white font-semibold underline underline-offset-8 decoration-2 decoration-white" : "text-brand-text/75 hover:text-white"}`}
      >
        About Us
      </a>
      <a
        href="/contact"
        class="px-5 py-2.5 bg-brand-tertiary text-brand-bg font-semibold text-base hover:bg-brand-muted transition-all duration-300 shadow-md inline-flex items-center space-x-2 group"
      >
        <span class="leading-none tracking-wide">Book a Discovery Call</span>
        <svg
          class="w-4 h-4 stroke-current transition-transform duration-300 group-hover:translate-x-1"
          fill="none"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"></path>
        </svg>
      </a>
    </div>

    <!-- Mobile Hamburger Button -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="md:hidden p-2 text-brand-text hover:text-brand-tertiary focus:outline-none transition-colors"
      aria-label="Toggle Navigation Menu"
      aria-expanded="false"
    >
      <span class="sr-only">Open menu</span>
      <!-- Hamburger Icon -->
      <svg
        id="menu-icon-open"
        class="w-7 h-7 block stroke-current"
        fill="none"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </nav>
</header>

<!-- Full-Screen Mobile Navigation Overlay -->
<div
  id="mobile-nav-overlay"
  class="fixed inset-0 z-50 bg-brand-bg text-brand-text flex flex-col justify-between p-6 sm:p-10 pointer-events-none opacity-0 invisible"
  aria-hidden="true"
>
  <!-- Full-screen Header -->
  <div class="flex items-center justify-between w-full border-b border-brand-text/25 pb-5">
    <a
      href="/"
      class="mobile-nav-item inline-flex items-center"
    >
      <Logo class="h-11 sm:h-14" />
    </a>

    <!-- Close Button (X) -->
    <button
      id="mobile-menu-close-btn"
      type="button"
      class="p-2 text-brand-text hover:text-brand-tertiary focus:outline-none transition-colors"
      aria-label="Close navigation menu"
    >
      <svg
        class="w-8 h-8 stroke-current"
        fill="none"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Full-screen Navigation Links -->
  <div class="my-auto flex flex-col space-y-6 sm:space-y-8 py-8">
    <a
      href="/"
      class={`mobile-nav-link text-4xl sm:text-5xl font-semibold tracking-tight leading-tight transition-colors w-fit ${currentPath === "/" ? "text-white underline underline-offset-8 decoration-2 decoration-white font-bold" : "text-brand-text/85 hover:text-white"}`}
    >
      Home
    </a>
    <a
      href="/services"
      class={`mobile-nav-link text-4xl sm:text-5xl font-semibold tracking-tight leading-tight transition-colors w-fit ${currentPath === "/services" ? "text-white underline underline-offset-8 decoration-2 decoration-white font-bold" : "text-brand-text/85 hover:text-white"}`}
    >
      Services
    </a>
    <a
      href="/ai-studio"
      class={`mobile-nav-link text-4xl sm:text-5xl font-semibold tracking-tight leading-tight transition-colors w-fit ${currentPath === "/ai-studio" ? "text-white underline underline-offset-8 decoration-2 decoration-white font-bold" : "text-brand-text/85 hover:text-white"}`}
    >
      AI Studio
    </a>
    <a
      href="/about"
      class={`mobile-nav-link text-4xl sm:text-5xl font-semibold tracking-tight leading-tight transition-colors w-fit ${currentPath === "/about" ? "text-white underline underline-offset-8 decoration-2 decoration-white font-bold" : "text-brand-text/85 hover:text-white"}`}
    >
      About Us
    </a>
    <a
      href="/contact"
      class="mobile-nav-link inline-flex items-center justify-between px-7 py-3.5 bg-brand-tertiary text-brand-bg font-semibold text-xl sm:text-2xl hover:bg-brand-muted transition-all duration-300 group shadow-lg mt-4 w-fit"
    >
      <span class="leading-none tracking-wide">Book a Discovery Call</span>
      <svg
        class="w-6 h-6 ml-4 stroke-current transition-transform duration-300 group-hover:translate-x-1.5"
        fill="none"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"></path>
      </svg>
    </a>
  </div>
</div>

<script>
  import gsap from "gsap";

  const openBtn = document.getElementById("mobile-menu-btn");
  const closeBtn = document.getElementById("mobile-menu-close-btn");
  const overlay = document.getElementById("mobile-nav-overlay");
  const navLinks = document.querySelectorAll(".mobile-nav-link");

  let isOpen = false;
  let isAnimating = false;

  const openMobileMenu = () => {
    if (!overlay || isOpen || isAnimating) return;
    isAnimating = true;

    // Lock background scrolling
    document.body.style.overflow = "hidden";

    // Set initial states instantly
    gsap.set(overlay, { opacity: 0, scale: 1, visibility: "visible", pointerEvents: "auto" });
    gsap.set(navLinks, { y: 10, opacity: 0 });

    const tl = gsap.timeline({
      onComplete: () => {
        isOpen = true;
        isAnimating = false;
        overlay.setAttribute("aria-hidden", "false");
        openBtn?.setAttribute("aria-expanded", "true");
      },
    });

    // Instant zero-delay entrance timeline (0ms perceived lag)
    tl.to(overlay, {
      opacity: 1,
      duration: 0.18,
      ease: "power2.out",
    }).to(
      navLinks,
      {
        y: 0,
        opacity: 1,
        duration: 0.18,
        stagger: 0.02,
        ease: "power2.out",
      },
      "-=0.16"
    );
  };

  const closeMobileMenu = () => {
    if (!overlay || !isOpen || isAnimating) return;
    isAnimating = true;

    const tl = gsap.timeline({
      onComplete: () => {
        gsap.set(overlay, { opacity: 0, visibility: "hidden", pointerEvents: "none" });
        document.body.style.overflow = "";
        isOpen = false;
        isAnimating = false;
        overlay.setAttribute("aria-hidden", "true");
        openBtn?.setAttribute("aria-expanded", "false");
      },
    });

    tl.to(overlay, {
      opacity: 0,
      duration: 0.15,
      ease: "power2.in",
    });
  };

  if (openBtn) openBtn.addEventListener("click", openMobileMenu);
  if (closeBtn) closeBtn.addEventListener("click", closeMobileMenu);

  // Close menu when clicking any nav link inside overlay
  navLinks.forEach((link) => {
    link.addEventListener("click", () => {
      closeMobileMenu();
    });
  });
</script>
