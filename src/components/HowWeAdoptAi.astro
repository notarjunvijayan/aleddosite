---
const deliveryPaths = [
  {
    title: "Aleddo Services",
    tagline: "Built around you",
    description:
      "When the workflow, data, or regulator makes a packaged product the wrong answer. Advisory & Consulting sets the direction, Training & Upskill carries your team, and Core Development builds and deploys it.",
    ctaText: "Explore Services",
    href: "/services",
  },
  {
    title: "Aleddo AI Studio",
    tagline: "Configured, not constructed",
    description:
      "When a platform gets you there faster. Digital Employees are AI colleagues sold per skill, running whole roles rather than single tasks — in our cloud or entirely inside yours.",
    ctaText: "Explore Platform",
    href: "/services",
  },
];
---

<section
  id="how-we-adopt-ai-section"
  class="relative w-full bg-brand-bg text-brand-text border-b border-brand-text/25 overflow-hidden"
>
  <div class="px-6 sm:px-10 lg:px-16 py-16 sm:py-20 lg:py-24">
    <!-- Centered Header & Subtitle -->
    <div class="max-w-4xl mx-auto text-center space-y-4 mb-12 sm:mb-16">
      <h2
        class="adopt-heading text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-brand-text leading-[1.12] sm:leading-[1.1]"
      >
        <span class="block text-brand-text">How We Help You</span>
        <span class="block text-brand-tertiary">Adopt AI</span>
      </h2>
      <p
        class="adopt-subheading text-base sm:text-lg md:text-xl lg:text-2xl text-brand-text/85 font-normal leading-[1.625] max-w-3xl mx-auto pt-2"
      >
        Both paths end in the same place: <strong
          class="text-brand-text font-semibold">AI running in production</strong
        >, governed, and owned by your team. They differ in how much gets built
        from scratch.
      </p>
    </div>

    <!-- Alternate 2-Column Side-by-Side Path Cards with Passing Horizontal Line -->
    <div class="relative w-full max-w-6xl mx-auto">
      <!-- Background Passing Line -->
      <div
        class="adopt-line-h absolute inset-x-0 top-1/2 -translate-y-1/2 h-px bg-brand-text/25 hidden md:block z-0 pointer-events-none origin-left"
        aria-hidden="true"
      >
      </div>

      <div
        class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12 relative z-10"
      >
        {
          deliveryPaths.map((path) => (
            <div class="adopt-card bg-brand-bg border border-brand-text/25 hover:border-brand-tertiary p-8 sm:p-12 flex flex-col justify-between space-y-8 relative overflow-hidden group transition-all duration-300 shadow-2xl">
              <div class="space-y-5">
                <div class="space-y-2">
                  <h3 class="text-2xl sm:text-3xl font-bold tracking-tight leading-snug text-brand-text">
                    {path.title}
                  </h3>
                  <p class="text-base sm:text-lg font-semibold text-brand-tertiary tracking-wide leading-snug">
                    {path.tagline}
                  </p>
                </div>
                <p class="text-base sm:text-lg lg:text-xl text-brand-text/85 leading-[1.65]">
                  {path.description}
                </p>
              </div>

              <div class="pt-4">
                <a
                  href={path.href}
                  class="inline-flex items-center justify-between w-full py-4 px-6 bg-brand-tertiary text-brand-bg font-semibold text-base sm:text-lg hover:bg-brand-muted transition-all duration-300 shadow-lg group-hover:bg-brand-tertiary"
                >
                  <span class="tracking-wide">{path.ctaText}</span>
                  <svg
                    class="w-5 h-5 stroke-current transition-transform duration-300 group-hover:translate-x-1.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"
                    />
                  </svg>
                </a>
              </div>

              <div class="absolute inset-0 bg-brand-tertiary/5 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none" />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initAdoptAiAnimation = () => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const section = document.getElementById("how-we-adopt-ai-section");
    if (!section) return;

    const lineH = section.querySelector(".adopt-line-h");
    const heading = section.querySelector(".adopt-heading");
    const subheading = section.querySelector(".adopt-subheading");
    const cards = section.querySelectorAll(".adopt-card");

    if (lineH) gsap.set(lineH, { scaleX: 0, transformOrigin: "left center" });
    if (heading) gsap.set(heading, { y: 20, opacity: 0 });
    if (subheading) gsap.set(subheading, { y: 15, opacity: 0 });
    if (cards.length) gsap.set(cards, { y: 20, opacity: 0 });

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: "top 75%",
        toggleActions: "play none none none",
      },
      defaults: { ease: "power4.out" },
    });

    if (heading) {
      tl.to(heading, { y: 0, opacity: 1, duration: 0.35 });
    }

    if (subheading) {
      tl.to(subheading, { y: 0, opacity: 1, duration: 0.3 }, "-=0.25");
    }

    if (lineH) {
      tl.to(lineH, { scaleX: 1, duration: 0.4 }, "-=0.2");
    }

    if (cards.length) {
      tl.to(
        cards,
        { y: 0, opacity: 1, duration: 0.35, stagger: 0.08 },
        "-=0.3",
      );
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initAdoptAiAnimation);
  } else {
    initAdoptAiAnimation();
  }
</script>
